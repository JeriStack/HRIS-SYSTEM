# ==============================================================================
# Git Ignore Configuration
# Employee HRIS & Leave Management System
# ==============================================================================

# Environment & Sensitive Credentials
.env
.env.*
!.env.example
!.env.docker.example
!.env.production.example
config/*.local.php

# Server & Application Logs
*.log
error_log
storage/logs/*
!storage/logs/.gitkeep

# Temporary & Cache Files
*.tmp
*.bak
*.swp
*~
.cache/
.phpunit.cache/
.phpcs.cache
.phpstan.cache/
.tflint.d/
backups/
*.sql.gz
cookies*.txt

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editor & IDE Settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Python & End-to-End Testing
.venv/
e2e-tests/.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
reports/
screenshots/
e2e-tests/reports/
e2e-tests/screenshots/
e2e-tests/.env


# Node & Composer Dependencies
node_modules/
vendor/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Public Uploads (preserve directory via .gitkeep)
public/uploads/*
!public/uploads/.gitkeep


# ==============================================================================
# Terraform (Infrastructure as Code)
# ==============================================================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.rc
terraform.rc
# Note: terraform.lock.hcl is explicitly TRACKED (do not ignore)

# ==============================================================================
# Impeccable Local & Ephemeral State
# ==============================================================================
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/live/inject-journal.json
