# ==============================================================================
# Environment Configuration Template (.env.example)
# Employee HRIS & Leave Management System
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit production .env files containing real secrets to version control.

# Application Environment ('development' for local XAMPP debug, 'production' for live deployment)
APP_NAME="Employee HRIS & Leave Management System"
APP_ENV=development
BASE_URL="http://localhost/GitHub_Clone_File_Projects/HRIS-SYSTEM/public"
TIMEZONE="Asia/Manila"
SESSION_LIFETIME=1800

# Database Connection (Dedicated least-privilege user recommended in production)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hris_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Production Security & Session Hardening
# SESSION_COOKIE_SECURE=true  # Enable only when serving over HTTPS
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax
