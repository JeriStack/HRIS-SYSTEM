# ==============================================================================
# Root Directory Protection & Public Redirection
# Employee HRIS & Leave Management System
# ==============================================================================

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive internal directories
    RewriteRule ^(app|core|config|database|scratch|docs)/ - [F,L]

    # Prevent direct access to sensitive files
    RewriteRule ^(\.env|\.git|\.github|composer\.(json|lock)|package(-lock)?\.json) - [F,L]

    # Forward any non-public request to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback access control for Apache without mod_rewrite
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
