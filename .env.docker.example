# ==============================================================================
# Docker Environment Configuration Template (.env.docker.example)
# Employee HRIS & Leave Management System
# ==============================================================================
# These environment variables match the docker-compose.yml configuration.

APP_NAME="Employee HRIS & Leave Management System"
APP_ENV=development
BASE_URL="http://localhost:8080"
TIMEZONE="Asia/Manila"
SESSION_LIFETIME=1800

# Host Port Mappings
APP_PORT=8080
DB_HOST_PORT=3307
PMA_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100

# Docker Database Connection (Internal network host: db, internal port: 3306)
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hris_db
DB_USERNAME=hris_user
DB_PASSWORD=hris_password
DB_CHARSET=utf8mb4

# Grafana Administrator Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
