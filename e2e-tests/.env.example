# ==============================================================================
# HRIS-SYSTEM — E2E UI Testing Environment Configuration (.env)
# ==============================================================================

# Target Application URL (defaults to running local Docker Nginx stack on port 8080)
HRIS_BASE_URL=http://localhost:8080

# Primary Browser: 'brave' (default), 'chrome', or 'remote'
SELENIUM_BROWSER=brave

# Headless mode: false for visible local automation, true in CI
SELENIUM_HEADLESS=false

# Explicit Brave Binary Path (Optional - automatically discovered if omitted)
# Windows default: C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
# Linux default: /usr/bin/brave-browser
BRAVE_BINARY=

# Remote Selenium Grid (when SELENIUM_BROWSER=remote or using docker-compose.e2e.yml)
SELENIUM_REMOTE_URL=http://localhost:4444/wd/hub

# Explicit Timeouts (in seconds)
SELENIUM_EXPLICIT_WAIT=10
SELENIUM_PAGE_LOAD_TIMEOUT=30

# Database Connection (Docker mapped to host port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=hris_db
DB_USERNAME=hris_user
DB_PASSWORD=hris_password

# Test Accounts (Seeded records)
TEST_HR_EMAIL=marcus.tan@company.local
TEST_HR_PASSWORD=Admin@123

TEST_EMP_EMAIL=david.cruz@company.local
TEST_EMP_PASSWORD=Employee@123

# Mailpit REST API (Optional for automated mail capture)
MAILPIT_API_URL=http://localhost:8025/api/v1

