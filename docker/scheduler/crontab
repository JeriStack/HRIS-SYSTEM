SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Run NEXORA HR Console Scheduler every minute as www-data (with flock overlap protection)
* * * * * www-data cd /var/www/html && /usr/local/bin/php /var/www/html/bin/schedule-run.php >> /proc/1/fd/1 2>> /proc/1/fd/2
