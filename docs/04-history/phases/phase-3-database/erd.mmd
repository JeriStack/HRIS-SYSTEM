erDiagram
    %% =========================================================================
    %% Entity Relationship Diagram: Employee HRIS & Leave Management System
    %% Database: hris_db (MySQL / MariaDB, InnoDB Engine)
    %% =========================================================================

    DEPARTMENTS ||--o{ POSITIONS : "offers"
    DEPARTMENTS ||--o{ EMPLOYEES : "employs"
    POSITIONS ||--o{ EMPLOYEES : "classifies"
    EMPLOYEES ||--o| USERS : "authenticates as"
    EMPLOYEES ||--o{ LEAVE_BALANCES : "allocated"
    EMPLOYEES ||--o{ LEAVE_REQUESTS : "files"
    LEAVE_TYPES ||--o{ LEAVE_BALANCES : "categorizes"
    LEAVE_TYPES ||--o{ LEAVE_REQUESTS : "defines"
    USERS ||--o{ LEAVE_REQUESTS : "approves"
    USERS ||--o{ ACTIVITY_LOGS : "generates"
    USERS ||--o{ NOTIFICATIONS : "receives"

    DEPARTMENTS {
        int id PK "INT UNSIGNED AUTO_INCREMENT"
        string department_name UK "VARCHAR(100) UNIQUE"
        string description "TEXT NULL"
        timestamp created_at "TIMESTAMP"
    }

    POSITIONS {
        int id PK "INT UNSIGNED AUTO_INCREMENT"
        string position_name "VARCHAR(100)"
        int department_id FK "INT UNSIGNED"
        string description "TEXT NULL"
        timestamp created_at "TIMESTAMP"
    }

    EMPLOYEES {
        int id PK "INT UNSIGNED AUTO_INCREMENT"
        string employee_no UK "VARCHAR(30) UNIQUE"
        string first_name "VARCHAR(50)"
        string middle_name "VARCHAR(50) NULL"
        string last_name "VARCHAR(50)"
        string email UK "VARCHAR(100) UNIQUE"
        string phone "VARCHAR(25) NULL"
        string address "TEXT NULL"
        date birth_date "DATE"
        enum gender "ENUM('Male','Female','Other')"
        int department_id FK "INT UNSIGNED"
        int position_id FK "INT UNSIGNED"
        date date_hired "DATE"
        enum employment_status "ENUM('Active','Inactive','Terminated')"
        timestamp created_at "TIMESTAMP"
    }

    USERS {
        int id PK "INT UNSIGNED AUTO_INCREMENT"
        int employee_id FK "INT UNSIGNED NULL UNIQUE"
        string username UK "VARCHAR(50) UNIQUE"
        string password "VARCHAR(255)"
        enum role "ENUM('admin','hr','employee')"
        enum status "ENUM('Active','Inactive')"
        timestamp created_at "TIMESTAMP"
    }

    LEAVE_TYPES {
        int id PK "INT UNSIGNED AUTO_INCREMENT"
        string leave_name UK "VARCHAR(100) UNIQUE"
        string description "TEXT NULL"
        int default_days "INT UNSIGNED DEFAULT 15"
        enum status "ENUM('Active','Inactive')"
        timestamp created_at "TIMESTAMP"
    }

    LEAVE_BALANCES {
        int id PK "INT UNSIGNED AUTO_INCREMENT"
        int employee_id FK "INT UNSIGNED"
        int leave_type_id FK "INT UNSIGNED"
        int year "INT UNSIGNED"
        int allocated_days "INT DEFAULT 0"
        int used_days "INT DEFAULT 0"
        int remaining_days "INT DEFAULT 0"
        timestamp created_at "TIMESTAMP"
    }

    LEAVE_REQUESTS {
        int id PK "INT UNSIGNED AUTO_INCREMENT"
        int employee_id FK "INT UNSIGNED"
        int leave_type_id FK "INT UNSIGNED"
        date start_date "DATE"
        date end_date "DATE"
        int number_of_days "INT UNSIGNED"
        string reason "TEXT"
        enum status "ENUM('Pending','Approved','Rejected','Cancelled')"
        int approved_by FK "INT UNSIGNED NULL"
        datetime approved_at "DATETIME NULL"
        timestamp created_at "TIMESTAMP"
    }

    ACTIVITY_LOGS {
        int id PK "INT UNSIGNED AUTO_INCREMENT"
        int user_id FK "INT UNSIGNED NULL"
        string action "VARCHAR(50)"
        string description "TEXT"
        string entity_type "VARCHAR(50) NULL"
        string entity_id "VARCHAR(50) NULL"
        string ip_address "VARCHAR(45) NULL"
        string user_agent "TEXT NULL"
        timestamp created_at "TIMESTAMP"
    }

    NOTIFICATIONS {
        int id PK "INT UNSIGNED AUTO_INCREMENT"
        int user_id FK "INT UNSIGNED"
        string title "VARCHAR(150)"
        string message "TEXT"
        enum type "ENUM('info','success','warning','error')"
        boolean is_read "TINYINT(1) DEFAULT 0"
        timestamp created_at "TIMESTAMP"
    }
