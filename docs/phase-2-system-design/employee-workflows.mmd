flowchart TD
    %% Global Entry
    AuthEntry([Authenticated User]) --> CheckRole{User Role?}

    %% =========================================================================
    %% EMPLOYEE WORKFLOWS
    %% =========================================================================
    subgraph EmployeePortal [Employee Portal Workflows]
        CheckRole -- Employee --> EmpDash[Employee Dashboard]

        %% Path 1: Profile & Balances
        EmpDash --> ViewProfile[View Personal Profile<br/>/profile]
        EmpDash --> ViewBal[View Leave Balances<br/>/leaves/balance]
        ViewBal --> BalDisplay[Display Allocated, Used & Remaining Days]

        %% Path 2: File Leave Request
        EmpDash --> FileLeave[Navigate to /leaves/apply]
        FileLeave --> InputLeave[Select Leave Type, Enter Start/End Dates & Reason]
        InputLeave --> ValEmpInput{Validate Form Data}
        
        ValEmpInput -- Invalid (Start > End or Empty) --> ValFailNotice[Display Date Validation Error] --> FileLeave
        ValEmpInput -- Valid --> CalcWorkDays[Calculate Working Days Excl. Weekends]
        CalcWorkDays --> CheckBalAvail{Working Days <= Remaining Balance?}
        CheckBalAvail -- Insufficient --> BalFailNotice[Display Insufficient Balance Alert] --> FileLeave
        CheckBalAvail -- Sufficient --> CheckOverlap{Overlap with Pending/Approved?}
        CheckOverlap -- Collision Detected --> OverlapFailNotice[Display Date Overlap Error] --> FileLeave
        CheckOverlap -- No Collision --> PersistPending[Insert Leave Request with status='Pending']
        PersistPending --> LogLeaveFiled[Record Activity Log & Dispatch HR Notification]
        LogLeaveFiled --> LeaveSuccess[Render Flash: Leave Application Submitted] --> ViewHistory

        %% Path 3: Leave History & Self-Cancellation
        EmpDash --> ViewHistory[View Personal Leave History<br/>/leaves/history]
        ViewHistory --> CheckCanCancel{Request status == 'Pending'?}
        CheckCanCancel -- Yes --> ClickCancel[Click 'Cancel Request']
        ClickCancel --> ConfirmCancelModal{Confirm Cancellation?}
        ConfirmCancelModal -- Confirmed --> UpdateCancelled[UPDATE status='Cancelled'<br/>No Balance Deduction]
        UpdateCancelled --> LogCancel[Record Activity Log] --> ViewHistory
        CheckCanCancel -- "Approved / Rejected / Cancelled" --> NoCancel[Cancellation Button Disabled]
    end

    %% =========================================================================
    %% ADMINISTRATOR / HR WORKFLOWS
    %% =========================================================================
    subgraph AdminPortal [Administrator / HR Workflows]
        CheckRole -- Administrator/HR --> AdminDash[HRIS Executive Dashboard]

        %% Path 1: Workforce Management
        AdminDash --> EmpMgmt[Employee Management<br/>/employees]
        EmpMgmt --> NewEmp[Register Employee]
        NewEmp --> SaveEmp[Validate Uniqueness & Persist to MySQL]
        SaveEmp --> InitEmpBal[Auto-Initialize Fiscal Leave Balances]
        EmpMgmt --> EditEmp[Edit Employee Contact & Job Details]
        EmpMgmt --> DeactEmp[Soft-Deactivate Employee<br/>employment_status = 'Inactive']
        
        %% Path 2: Organization Hierarchy
        AdminDash --> OrgMgmt[Manage Departments & Positions]
        OrgMgmt --> RestrictCheck{Has Linked Employees?}
        RestrictCheck -- Yes --> BlockDelete[Block Permanent Deletion<br/>Foreign Key Restricted]
        RestrictCheck -- No --> ModifyOrg[Save Organization Changes]

        %% Path 3: Leave Review & Transactional Approval
        AdminDash --> ReviewQueue[Review Pending Requests Queue<br/>/leaves/manage]
        ReviewQueue --> PopQueue[Select Top FIFO Queued Request]
        PopQueue --> Decision{HR Decision}
        
        Decision -- Approve --> BeginTx[BEGIN PDO TRANSACTION]
        BeginTx --> RecheckState{Status still Pending & Balance sufficient?}
        RecheckState -- No --> RollbackTx[ROLLBACK TRANSACTION] --> ErrorAlert[Display Concurrency Conflict Alert]
        RecheckState -- Yes --> AtomicCommit[UPDATE status='Approved'<br/>DEDUCT used/remaining days<br/>LOG Activity & NOTIFY Employee]
        AtomicCommit --> CommitTx[COMMIT TRANSACTION] --> ApproverSuccess[Display Success Notice]

        Decision -- Reject --> RejectAction[UPDATE status='Rejected'<br/>Balance Untouched<br/>NOTIFY Employee]

        %% Path 4: Analytics & Audit
        AdminDash --> GenReports[Generate Reports:<br/>Workforce, Leaves, Departments]
        AdminDash --> ViewAudit[Inspect Activity Audit Logs<br/>Top-N Recent Activity Stack]
        AdminDash --> DsaLabNav[Access DSA Laboratory & Benchmarks]
    end
